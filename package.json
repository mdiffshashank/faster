{
  "name": "@mdiffshashank/faster-ui",
  "version": "0.1.7",
  "description": "Faster design system — production-ready, accessible React component library",
  "type": "module",
  "main": "./dist/faster.cjs.js",
  "module": "./dist/faster.es.js",
  "types": "./dist/faster.d.ts",
  "exports": {
    ".": {
      "types": "./dist/faster.d.ts",
      "import": "./dist/faster.es.js",
      "require": "./dist/faster.cjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "tsc --noEmit && tsup",
    "lib:build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "cypress:open": "cypress open --component",
    "cypress:run": "cypress run --component",
    "cypress:verify": "cypress verify",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "prepare": "husky"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "husky": "^9.1.5",
    "@cypress/react": "^9.0.2",
    "@cypress/vite-dev-server": "^7.3.4",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.5.9",
    "@storybook/addon-docs": "^10.5.9",
    "@storybook/react-vite": "^10.5.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "cypress": "^15.20.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "storybook": "^10.5.8",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.4.12",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1"
  }
}
